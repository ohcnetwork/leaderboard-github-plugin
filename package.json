{
  "name": "@ohcnetwork/leaderboard-github-plugin",
  "version": "0.3.0",
  "private": false,
  "description": "Leaderboard github plugin",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@libsql/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "leaderboard",
    "plugin"
  ],
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@octokit/core": "^7.0.7",
    "@octokit/plugin-paginate-graphql": "^6.0.0",
    "@octokit/plugin-paginate-rest": "^14.0.0",
    "@octokit/plugin-rest-endpoint-methods": "^17.0.0",
    "@ohcnetwork/leaderboard-api": "^0.4.0",
    "date-fns": "^4.4.0",
    "octokit": "^5.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.19.43",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "author": "Open Healthcare Network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohcnetwork/leaderboard-github-plugin.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
