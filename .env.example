# GitHub organization to scrape
GITHUB_ORG=your-org-name

# Single token (basic setup)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Multiple tokens for rate limit rotation (recommended for large orgs)
# GITHUB_TOKEN_1=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_TOKEN_2=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_TOKEN_3=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Path to data repository
LEADERBOARD_DATA_DIR=./data
